<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus Event Portal - Home</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
            color: #333;
        }
        nav {
            background-color: #2c3e50;
            color: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 20px;
            font-weight: bold;
        }

        nav ul {
            list-style: none;
            display: flex;
            margin: 0;
            padding: 0;
        }

        nav ul li {
            margin-left: 20px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            font-size: 16px;
        }

        nav ul li a:hover {
            color: #3498db;
        }

        .hero {
            text-align: center;
            padding: 80px 20px;
        }

        .hero h1 {
            font-size: 36px;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 18px;
            color: #7f8c8d;
            margin-bottom: 20px;
        }

        .btn {
            display: inline-block;
            background-color: #3498db;
            color: white;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
        }

        .btn:hover {
            background-color: #2980b9;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 15px;
            background-color: #2c3e50;
            color: white;
            position: fixed;
            bottom: 0;
            width: 100%;
        }
    </style>
</head>
<body>

    <nav>
        <div class="logo">Campus Events</div>
        <ul>
            <li><a href="index.html">Home</a></li>
            <li><a href="#">Events</a></li>
            <li><a href="#">Login</a></li>
        </ul>
    </nav>

    <div class="hero">
        <h1>Welcome to Campus Event Portal</h1>
        <p>Manage and register for all university events easily in one place.</p>
        <a href="#" class="btn">Explore Events</a>
    </div>

    <footer>
        <p>&copy; 2026 Campus Event Portal | Week 1 - Commit 2</p>
    </footer>

</body>
</html>